{
  "name": "dsh-plugin-testing",
  "version": "1.0.0",
  "private": true,
  "description": "DSH 插件测试基建 monorepo：testkit（隔离 home / keyless 回放）+ conformance（静态门禁）+ 指南与模板",
  "scripts": {
    "test": "node --test \"packages/conformance/tests/*.spec.mjs\" \"packages/testkit/tests/*.spec.mjs\"",
    "test:conformance": "node --test \"packages/conformance/tests/*.spec.mjs\"",
    "test:testkit": "node --test \"packages/testkit/tests/*.spec.mjs\"",
    "selfcheck": "node packages/conformance/src/run-all.mjs --config fixtures/conformance.selfcheck.json"
  }
}
